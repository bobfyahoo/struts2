<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 2.5//EN"
    "http://struts.apache.org/dtds/struts-2.5.dtd">

<struts>

    <!-- Route v2 through the REST mapper; everything else through normal Struts -->
    <constant name="struts.mapper.class"
              value="org.apache.struts2.dispatcher.mapper.PrefixBasedActionMapper"/>

    <constant name="struts.mapper.prefixMapping"
              value="/api/v2:rest,/api/v3:rest,:struts"/>

    <constant name="struts.actionProxyFactory"
              value="prefix"/>

    <constant name="struts.action.extension"
              value="xhtml,,xml,json,action"/>

    <!-- index.jsp -->
    <package name="default" namespace="/" extends="struts-default">

        <action name="">
            <result>/index.jsp</result>
        </action>

    </package>

    <!-- API v1: existing controller -->
    <package name="ticket-api-v1"
             namespace="/api/v1"
             extends="struts-default">

        <!-- Preserve your existing v1 action mapping -->
        <action name="tickets"
                class="action.v1.TicketController"/>
    </package>


    <!-- API v2: REST plugin -->
    <package name="ticket-api-v2"
             namespace="/api/v2"
             extends="rest-default">

        <action name="tickets"
                class="action.v2.TicketController"/>
    </package>

    <!-- API v2: REST plugin -->
    <package name="ticket-api-v3"
             namespace="/api/v3"
             extends="rest-default">

        <action name="tickets"
                class="action.v3.TicketController"/>
    </package>

</struts>
